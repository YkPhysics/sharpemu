<!-- PS-button in-game overlay, control-center style. A borderless owned
     window rather than a popup: owned windows always sit above their owner
     (including its native child game surface) and, unlike popups, are not
     clamped to the monitor's work area — so the sheet can truly cover the
     whole window even over the taskbar region. Shown without activation so
     the launcher keeps reading the gamepad. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpEmu.GUI.GameOverlayWindow"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">

  <Panel x:Name="OverlayRoot">

    <!-- Sheet background: overall dim deepening into a bottom gradient
         the content sits on. Clicking it resumes the game. -->
    <Border x:Name="OverlayDimLayer">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#47000105" />
          <GradientStop Offset="0.6" Color="#7A020509" />
          <GradientStop Offset="1" Color="#F004070C" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>

    <!-- Top-right system status: clock and controller battery. -->
    <StackPanel x:Name="OverlayTopBar" Orientation="Horizontal" Spacing="16"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,44,0">
      <StackPanel x:Name="OverlayBatteryPanel" Orientation="Horizontal" Spacing="0"
                  VerticalAlignment="Center" IsVisible="False">
        <Border Width="21" Height="11" BorderBrush="#C4FFFFFF" BorderThickness="1.3"
                CornerRadius="3" Padding="1.4" VerticalAlignment="Center">
          <Rectangle x:Name="OverlayBatteryFill" Fill="#F2FFFFFF" HorizontalAlignment="Left"
                     Width="14" RadiusX="1" RadiusY="1" />
        </Border>
        <Border Width="2.2" Height="5" Background="#C4FFFFFF" CornerRadius="1"
                VerticalAlignment="Center" Margin="1,0,0,0" />
        <TextBlock x:Name="OverlayBatteryText" Text="" FontSize="12" Foreground="#D9FFFFFF"
                   VerticalAlignment="Center" Margin="6,0,0,0" />
      </StackPanel>
      <TextBlock x:Name="OverlayClockText" Text="00:00" FontSize="21" FontWeight="Normal"
                 Foreground="#F2FFFFFF" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Bottom sheet: game card above-left, icon row beneath it. -->
    <StackPanel x:Name="OverlaySheet" VerticalAlignment="Bottom" Spacing="30" Margin="52,0,52,36">

      <Border x:Name="OverlayGameCard" Background="#66070A10" CornerRadius="18" Padding="14,12"
              HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Classes="coverClip" Width="66" Height="66" CornerRadius="14"
                  VerticalAlignment="Center">
            <Panel>
              <Border x:Name="OverlayCoverFallback" Background="#1B2230">
                <TextBlock x:Name="OverlayCoverInitials" FontSize="20" FontWeight="Bold"
                           Foreground="#E8ECF4" Opacity="0.85"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <Image x:Name="OverlayCoverImage" Stretch="UniformToFill" IsVisible="False" />
            </Panel>
          </Border>
          <StackPanel Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
            <TextBlock x:Name="OverlayGameTitle" Text="Game" FontSize="17" FontWeight="SemiBold"
                       Foreground="#F7FFFFFF" MaxWidth="420" HorizontalAlignment="Left"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock x:Name="OverlayElapsedText" Text="0m" FontSize="12"
                         Foreground="#A6FFFFFF" VerticalAlignment="Center" />
              <TextBlock x:Name="OverlayTitleIdText" FontSize="12" Foreground="#73FFFFFF"
                         VerticalAlignment="Center" IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Icon row: label appears ABOVE the focused tile; the focus ring
           is a detached white circle around the frosted button. -->
      <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock x:Name="OverlayResumeLabel" Text="Resume" FontSize="12" Height="16"
                     TextAlignment="Center" Foreground="#F2FFFFFF" />
          <Grid Width="66" Height="66">
            <Border x:Name="OverlayResumeRing" Classes="overlayRing" />
            <Button x:Name="OverlayResumeButton" Classes="overlayIcon">
              <Path Data="M7,4.6 L15.8,10 L7,15.4 Z" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock x:Name="OverlayScreenshotLabel" Text="Screenshot" FontSize="12" Height="16"
                     TextAlignment="Center" Foreground="#F2FFFFFF" />
          <Grid Width="66" Height="66">
            <Border x:Name="OverlayScreenshotRing" Classes="overlayRing" />
            <Button x:Name="OverlayScreenshotButton" Classes="overlayIcon">
              <Path Data="M3.6,7.6 a1.6,1.6 0 0 1 1.6,-1.6 h1.9 l1.3,-1.7 h3.2 l1.3,1.7 h1.9 a1.6,1.6 0 0 1 1.6,1.6 v6 a1.6,1.6 0 0 1 -1.6,1.6 h-9.6 a1.6,1.6 0 0 1 -1.6,-1.6 z M10,10.6 m-2.6,0 a2.6,2.6 0 1 0 5.2,0 a2.6,2.6 0 1 0 -5.2,0" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock x:Name="OverlayFullscreenLabel" Text="Fullscreen" FontSize="12" Height="16"
                     TextAlignment="Center" Foreground="#F2FFFFFF" />
          <Grid Width="66" Height="66">
            <Border x:Name="OverlayFullscreenRing" Classes="overlayRing" />
            <Button x:Name="OverlayFullscreenButton" Classes="overlayIcon">
              <Path Data="M4,8 V4 H8 M12,4 H16 V8 M16,12 V16 H12 M8,16 H4 V12" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock x:Name="OverlayConsoleLabel" Text="Console" FontSize="12" Height="16"
                     TextAlignment="Center" Foreground="#F2FFFFFF" />
          <Grid Width="66" Height="66">
            <Border x:Name="OverlayConsoleRing" Classes="overlayRing" />
            <Button x:Name="OverlayConsoleButton" Classes="overlayIcon">
              <Path Data="M4.5,6.2 H15.5 M4.5,10 H15.5 M4.5,13.8 H15.5" />
            </Button>
          </Grid>
        </StackPanel>
        <StackPanel Spacing="10">
          <TextBlock x:Name="OverlayQuitLabel" Text="Close Game" FontSize="12" Height="16"
                     TextAlignment="Center" Foreground="#F2FFFFFF" />
          <Grid Width="66" Height="66">
            <Border x:Name="OverlayQuitRing" Classes="overlayRing" />
            <Button x:Name="OverlayQuitButton" Classes="overlayIcon">
              <Path Data="M10,3.5 V9.5 M6.2,5.6 a5.6,5.6 0 1 0 7.6,0" />
            </Button>
          </Grid>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Panel>
</Window>
